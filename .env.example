# Copy this file to .env (which is gitignored) and fill in the values.

# RDS endpoint, from the RDS console: Databases > baltimore-311 > Connectivity & security
PGHOST=baltimore-311.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=baltimore311

# Admin (master) user, used by the pipeline to create tables and load data
PGUSER=postgres
PGPASSWORD=change-me

# Read-only user for the dashboard; created by pipeline/db_setup.py
DASHBOARD_USER=dashboard_ro
DASHBOARD_PASSWORD=change-me-too
